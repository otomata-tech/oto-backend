# oto-mcp environment

# Public base URL (used by the OAuth provider to construct absolute URLs)
OTO_MCP_PUBLIC_URL=https://mcp.oto.ninja

# Shared password gating the OAuth login form (single-user MVP)
OTO_MCP_OAUTH_PASSWORD=change-me

# Optional overrides:
# MCP_TRANSPORT=streamable_http   # or `stdio` for local
# HOST=127.0.0.1
# PORT=9103
# LOG_LEVEL=INFO

# Datastore — la date à partir de laquelle poser la couche `origine` SANS le déclarer
# est refusé (oto#70 lot 2). La date par DÉFAUT vit dans le code
# (`datastore/schema.py:ORIGINE_REFUS_LE`, aujourd'hui 2026-10-01) : ce que le produit
# annonce à chaque écriture est ce qu'il refusera, sans dépendre d'un geste sur une box.
# Ce réglage la DÉPLACE, sans déploiement, si un écrivain se manifeste pendant le
# préavis. Format `YYYY-MM-DD` ; une valeur illisible LÈVE plutôt que de retomber sur le
# défaut — un préavis dont la date est muette annoncerait une échéance que rien
# n'applique.
# OTO_ORIGINE_REFUS_LE=2026-10-01

# Egress des connecteurs — la liste des destinations INTERNES autorisées.
# Sept connecteurs prennent leur hôte dans le credential, donc chez un admin d'org
# cliente (`http`, `n8n`, `make`, `github`, `lighton`, `posthog`, `salesforce`). Une
# destination qui RÉSOUT vers une adresse non publique — boucle locale, plage privée,
# lien-local — est refusée, sauf à figurer ici. Format : `nom=adresse:port`, séparés
# par des virgules. L'adresse est littérale (un nom d'hôte peut se déplacer sous nous)
# et le port est obligatoire (une exception par adresse seule ouvrirait toute la
# machine). Absent = aucune exception : un pont hébergé en local CESSE de répondre, avec
# un message qui nomme cette variable. Détail : docs/connector-vault.md §Egress.
# OTO_EGRESS_ALLOW=pont-local=127.0.0.1:9000,service-interne=10.0.0.5:9002

# Error tracking Sentry (SaaS). Absent → Sentry désactivé (no-op).
# OTO_SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>
# OTO_SENTRY_ENV=production
# OTO_SENTRY_RELEASE=                       # ex. SHA git du deploy (optionnel)
# OTO_SENTRY_TRACES_SAMPLE_RATE=0           # tracing de perf (0 = off)
