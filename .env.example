# Limite de débit applicative (`limite_debit.py`, F-025) : `report` (défaut)
# mesure et journalise ce qui serait refusé sans rien refuser, `enforce` refuse
# en 429, `off` la coupe ; une valeur inconnue empêche le démarrage. `enforce`
# SEULEMENT derrière un proxy qui écrase `CF-Connecting-IP` et `X-Forwarded-For`
# (sinon les classes par adresse se contournent). Le MÊME interrupteur gouverne
# les bornes globales du processus (`bornes_processus`, #1232 : corps, délai
# d'outil, `statement_timeout`, inactivité des sessions MCP) : `report` les
# mesure, `enforce` les applique. Lue au démarrage : en changer demande un
# redémarrage.
# Réf. : oto_mcp/limite_debit.py:179, oto_mcp/bornes_processus.py:108
# OTO_DEBIT_MODE=report

# Borne du processus (#1232) : taille max (octets) du corps d'une requête HTTP
# hors routes d'upload. Mesurée en `report`, `413` en `enforce`
# (`OTO_DEBIT_MODE`) ; `0` désarme ; une valeur illisible empêche le démarrage.
# Réf. : oto_mcp/bornes_processus.py:110
# OTO_BORNE_CORPS_OCTETS=4194304

# Borne du processus (#1232) : taille max (octets) du corps sur une route
# d'upload (reconnue à son contrat : corps déclaré non JSON). Mesurée en
# `report`, `413` en `enforce` ; `0` désarme ; illisible : refus de démarrer.
# Réf. : oto_mcp/bornes_processus.py:113
# OTO_BORNE_CORPS_UPLOAD_OCTETS=115343360

# Borne du processus (#1232) : durée max (s) d'un appel d'outil MCP, la même
# pour tous. Mesurée en `report`, erreur MCP `tool_timeout` en `enforce` ; `0`
# désarme ; illisible : refus de démarrer.
# Réf. : oto_mcp/bornes_processus.py:114
# OTO_BORNE_OUTIL_S=120

# Borne du processus (#1232) : inactivité max (s) d'une session MCP. Mesurée en
# `report` (session reprise après ce délai), fermée par l'SDK `mcp` en `enforce`
# ; `0` désarme ; illisible : refus de démarrer.
# Réf. : oto_mcp/bornes_processus.py:119
# OTO_BORNE_SESSION_INACTIVE_S=1800

# Adresses ou CIDR (séparés par des virgules) de NOS machines, exemptés des
# classes de débit par adresse et du budget d'échecs ; leurs jetons paient
# toujours la classe par jeton. Vide par défaut ; une entrée illisible empêche
# le démarrage. Lue au démarrage.
# Réf. : oto_mcp/limite_debit.py:190
# OTO_DEBIT_ADRESSES_EXEMPTEES=

# Adresses ou CIDR (séparés par des virgules) des proxies dont on croit les
# en-têtes d'adresse (`CF-Connecting-IP`, `X-Forwarded-For`) : lus seulement si
# le pair TCP en fait partie. Vide par défaut : on lit le pair TCP — derrière un
# proxy, TOUT le trafic aurait alors son adresse. Une entrée illisible empêche
# le démarrage. Lue au démarrage.
# Réf. : oto_mcp/client_trace.py:56
# OTO_PROXIES_DE_CONFIANCE=

# Débit (req/min) par jeton porté (`Authorization`), rafale = la moitié ; `0`
# désarme la classe.
# Réf. : oto_mcp/limite_debit.py:221
# OTO_DEBIT_JETON_PAR_MIN=1200

# Débit (req/min) par adresse d'une requête sans jeton, hors routes sensibles et
# webhooks (DCR compris) ; rafale = la moitié ; `0` désarme.
# Réf. : oto_mcp/limite_debit.py:223
# OTO_DEBIT_ANONYME_PAR_MIN=600

# Débit (req/min) par adresse sur les routes à secret dans le chemin et les
# gestes d'authentification interactifs (invitation, partage public,
# autorisation, retours OAuth) ; rafale = la moitié ; `0` désarme.
# Réf. : oto_mcp/limite_debit.py:225
# OTO_DEBIT_SENSIBLE_PAR_MIN=60

# Débit (req/min) par (adresse, chemin) des webhooks entrants, plus un plafond
# par adresse à dix fois ce débit ; rafale = la moitié ; `0` désarme.
# Réf. : oto_mcp/limite_debit.py:227
# OTO_DEBIT_WEBHOOK_PAR_MIN=300

# Budget (par min) de réponses 401/403 (et 404 sur routes à secret) par adresse
# ; épuisé, l'adresse voit refuser ses jetons inconnus et ses routes à secret —
# jamais un jeton déjà accepté, ni l'anonyme, ni un webhook ; `0` désarme ce
# budget.
# Réf. : oto_mcp/limite_debit.py:228
# OTO_DEBIT_ECHECS_PAR_MIN=120

