# OTO_MCP_S3_PUBLIC_BASE_URL=

# DSN Sentry — vide, Sentry est no-op.
# Réf. : oto_mcp/sentry_setup.py:90
# OTO_SENTRY_DSN=

# Environnement annoncé à Sentry. Sert AUSSI de seconde déclaration croisée avec
# `OTO_ENV` dans `est_la_production()` — vide, il ne vote pas.
# Réf. : oto_mcp/sentry_setup.py:102, oto_mcp/config.py:151
# OTO_SENTRY_ENV=

# Release annoncée à Sentry — vide, l'étiquette de la version servie
# (`v1.2.3+6d5bf16b`, celle de `/api/version`).
# Réf. : oto_mcp/sentry_setup.py:103
# OTO_SENTRY_RELEASE=

# Taux d'échantillonnage du tracing de perf Sentry — 0 = off.
# Réf. : oto_mcp/sentry_setup.py:115
# OTO_SENTRY_TRACES_SAMPLE_RATE=0

# Issuer additionnel toléré pendant une migration de tenant.
# Réf. : oto_mcp/tenant_migration.py:60, oto_mcp/tenant_migration.py:71
# OTO_MCP_TENANT_MIGRATION_ISS=

# Sub d'un compte admin plateforme, pour des scripts hors requête.
# Réf. : oto_mcp/access/scope.py:47
# OTO_MCP_ADMIN_SUB=

# Repli d'identité DEV local, sans jeton — refusé au boot s'il coexiste avec
# `LOGTO_ENDPOINT` (`verifier_repli_identite_dev`).
# Réf. : oto_mcp/auth/hooks.py:164, oto_mcp/config.py:179
# OTO_MCP_DEV_SUB=

# Second émetteur Logto toléré (coexistence multi-domaine), pour les personnes
# comme pour les services.
# Réf. : oto_mcp/server.py:228, oto_mcp/auth/service_identity.py:91
# LOGTO_ENDPOINT_ALT=

# Clé maîtresse (hex 64 ou base64) de l'instance CIBLE d'un export par
# périmètre, pour cette seule exécution de `oto-mcp perimetre export` : les
# secrets y sont rechiffrés depuis `OTO_MCP_MASTER_KEY`. Absente, un périmètre
# qui porte des secrets refuse. Jamais dans l'environnement du serveur.
# Réf. : oto_mcp/export_perimetre/commande.py:49
# OTO_EXPORT_CLE_CIBLE=

# Réf. git du deploy en cours, affichée par `/api/version`.
# Réf. : oto_mcp/version.py:61, oto_mcp/version.py:122
# OTO_DEPLOY_REF=

# SHA git du deploy en cours.
# Réf. : oto_mcp/version.py:62
# OTO_DEPLOY_SHA=

# Horodatage du deploy en cours.
# Réf. : oto_mcp/version.py:63
# OTO_DEPLOY_AT=

# ── FAMILLES DYNAMIQUES — le NOM lui-même se construit au runtime, donc
# aucune ligne KEY=VALUE fixe ici. Posées au cas par cas (par provider, par
# annuaire tenant) : ────────────────────────────────────────────────────
# Quota journalier de la clé plateforme d'UN connecteur
# (`OTO_MCP_QUOTA_<PROVIDER>_DAILY`, provider en MAJUSCULES). Normalisé vers le
# porteur du credential.
# Forme : OTO_MCP_QUOTA_<...>_DAILY — réf. : oto_mcp/access/quotas.py:119
# Moitié `_ID` du credential de management d'un annuaire tenant
# (`<CREDENTIAL>_ID`) — le primaire est `OTO_MCP_LOGTO_M2M_ID`, les autres
# viennent de `tenants.logto_mgmt.credential` en base. Obligatoire DE FAIT pour
# l'annuaire visé : `_mgmt_token()` lève nommé si absent.
# Forme : <...>_ID — réf. : oto_mcp/auth/annuaire.py:98, oto_mcp/auth/annuaire.py:105
# Moitié `_SECRET` du même credential — voir `credential_management_annuaire`.
# Forme : <...>_SECRET — réf. : oto_mcp/auth/annuaire.py:99, oto_mcp/auth/annuaire.py:106
