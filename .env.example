# Expose la facturation (REST/MCP/dashboard/runner) — off par défaut.
# Réf. : oto_mcp/billing.py:78
# OTO_BILLING_ENABLED=0

# Tick du runner d'agents.
# Réf. : oto_mcp/runner_tick.py:163
# OTO_RUNNER_TICK_ENABLED=1

# Écrit l'observation shadow de la fenêtre L7 sans en changer l'issue.
# Réf. : oto_mcp/access/chain_shadow.py:93
# OTO_L7_SHADOW=1

# Fait PASSER la fenêtre L7 de l'observation à la décision — vide = observe
