# oto-mcp environment
#
# Fichier DÉRIVÉ — ne pas éditer à la main. Régénéré depuis
# oto_mcp/env_inventory.py par `python -m scripts.generer_env_example`
# (oto-backend#968). Toute variable lue par le code y a une entrée ;
# `tests/test_env_inventory_complet.py` le garantit contre le CODE et
# `tests/test_env_example_a_jour.py` garantit CE fichier contre l'inventaire.

# ── REQUISES — le boot (ou le premier appel qui en dépend) échoue
# proprement sans elles. Aucun défaut : à poser explicitement. ──────────

# Connexion PG managée — source unique du pool applicatif ET des migrations
# Alembic (décision du 15/09/2026 : un message de boot nommé plutôt qu'une
# erreur psycopg opaque).
# Réf. : oto_mcp/db/_conn.py:57, oto_mcp/db/migrations/env.py:51
DATABASE_URL=

# Émetteur Logto qui SIGNE (vérification JWT ES384), et que la découverte
# ANNONCE comme serveur d'autorisation (+ `/oidc`) : une seule adresse, celle de
# l'`issuer`. Le Logto doit avoir CIMD activé.
# Réf. : oto_mcp/server.py:243, oto_mcp/auth/decouverte.py:35, oto_mcp/auth/annuaire.py:70
LOGTO_ENDPOINT=

# Audience RFC 9728 canonique vérifiée sur chaque jeton.
# Réf. : oto_mcp/server.py:290
MCP_AUDIENCE=

# Endpoint S3/Scaleway du store média.
# Réf. : oto_mcp/media_store.py:60
OTO_MCP_S3_ENDPOINT=

# Clé d'accès S3 du store média.
# Réf. : oto_mcp/media_store.py:62
OTO_MCP_S3_ACCESS_KEY=

# Clé secrète S3 du store média.
# Réf. : oto_mcp/media_store.py:63
OTO_MCP_S3_SECRET_KEY=

# Bucket S3 du store média.
# Réf. : oto_mcp/media_store.py:70
OTO_MCP_S3_BUCKET=

# Clé AES-256 (hex 64 ou base64) du coffre credentials — HORS DB. Obligatoire DE
# FAIT : la lecture rend `None` sans lever, mais `encrypt`/`decrypt` lèvent
# nommé au premier usage réel.
# Réf. : oto_mcp/crypto.py:45, oto_mcp/crypto.py:65, oto_mcp/crypto.py:74
OTO_MCP_MASTER_KEY=

# Clé qui signe l'état OAuth et les jetons courts (upload, invite, optout).
# Obligatoire DE FAIT à 4 des 5 sites qui la lisent (lèvent nommé) ;
# `journal_secrets.py` est l'exception VOLONTAIRE — sans elle (dev, tests) il
# dégrade vers une clé de process aléatoire, le masque reste correct et cesse
# seulement d'être corrélable entre deux boots.
# Réf. : oto_mcp/auth/flow.py:66, oto_mcp/auth/google.py:87, oto_mcp/outreach_optout.py:57, oto_mcp/upload_tokens.py:72
OTO_MCP_OAUTH_STATE_SECRET=

# Client OAuth Google Workspace — NOTRE app, servie à tout compte dont le tenant
# n'a pas posé la sienne en app d'éditeur (`google_oauth.app_for`). Obligatoire
# DE FAIT : lève nommé au premier appel de `_client_id()`.
# Réf. : oto_mcp/auth/google.py:92
GOOGLE_WORKSPACE_CLIENT_ID=

# Secret OAuth Google Workspace (même repli). Obligatoire DE FAIT : lève nommé
# au premier appel de `_client_secret()`.
# Réf. : oto_mcp/auth/google.py:99
GOOGLE_WORKSPACE_CLIENT_SECRET=

# Base URL du service FOD (ADR 0028 — CCN, jurisprudence, lois, règlements,
# DVF). Obligatoire DE FAIT : lue nue au niveau module, `_client()` lève nommé
# au premier appel si absente.
# Réf. : oto_mcp/fod/http.py:24, oto_mcp/fod/http.py:42
FOD_BASE_URL=

# Jeton du service FOD. Même mécanique que `FOD_BASE_URL`.
# Réf. : oto_mcp/fod/http.py:25, oto_mcp/fod/http.py:42
FOD_API_TOKEN=

# Les défauts des droits déclarés (ADR 0070 §7, #1066) : la valeur de chaque
# droit du catalogue pour qui n'en a aucun posé, en JSON — `{"unipile": 0,
# "platform_unmetered": 0, "unipile_seats": 5, "members_max": "unlimited",
# "platform_key:*": 0, "platform_key:<c>": n}` (oui/non = 1/0, nombre >= 0 ou
# `unlimited`, joker `platform_key:*` et surcharges par connecteur). Une clé du
# catalogue ni déclarée ni couverte refuse le démarrage.
# `scripts/defauts_des_droits.py` imprime ceux de l'instance historique, dérivés
# du registre.
# Réf. : oto_mcp/access/entitlements.py:42, oto_mcp/server.py:997
OTO_ENTITLEMENT_DEFAULTS=

# L'agent de la ferme des sandboxes d'abonnement (réseau privé du parc,
# `http://172.16.16.2:8190`). Sans lui, se connecter ou effacer son sandbox
# échoue en 502 nommé ; rien d'autre n'en dépend.
# Réf. : oto_mcp/ferme.py:45
OTO_FERME_URL=

# Le jeton de l'agent de la ferme (1Password « Ferme de Claude — jeton de l
# agent »). Même sort que OTO_FERME_URL.
# Réf. : oto_mcp/ferme.py:45
OTO_FERME_TOKEN=

# ── IDENTITÉ DE L'INSTANCE — ses adresses, ses emails, sa marque, ses
# contrats. Aucun défaut : toute instance les déclare (prod comprise ; en
# dev, dans ce .env), sinon elle refuse de démarrer (décision du
# 28/09/2026, `identite_instance.verifier`). ─────────────────────────────

# L'adresse publique de CETTE instance — seule source des liens donnés à un
# tiers (redirection OAuth, rappel de paiement, jeton de téléversement, suffixe
# d'hôte, contact des sondes sortantes).
# Réf. : oto_mcp/config.py:37, oto_mcp/server.py:418
OTO_MCP_PUBLIC_URL=

# Domaine racine des endpoints de projet publiés (`<slug>.mcp.<D>`,
# `<slug>.share.<D>`).
# Réf. : oto_mcp/config.py:66
OTO_PROJECT_DOMAIN=

# Première variable de la cascade `config.dashboard_url()` (adresse du tableau
# de bord servie aux utilisateurs) — une seule des trois suffit.
# Réf. : oto_mcp/config.py:229, oto_mcp/auth/flow.py:189
OTO_APP_URL=

# Deuxième variable de la cascade `dashboard_url()` — voir `OTO_APP_URL`.
# Réf. : oto_mcp/config.py:229
OTO_DASHBOARD_URL=

# Troisième variable de la cascade `dashboard_url()` — voir `OTO_APP_URL`.
# Réf. : oto_mcp/config.py:229
OTO_DASHBOARD_BASE_URL=

# Base des liens d'invitation d'une org sans front déclaré
# (`orgs.front_base_url` gagne quand il est posé).
# Réf. : oto_mcp/config.py:246
OTO_INVITE_BASE_URL=

# Origines navigateur autorisées sur `/api/*`, séparées par des virgules — les
# fronts de l'instance, et en développement les ports `localhost` du poste. Un
# env-liste s'ÉTEND, ne se remplace jamais (docs/auth-logto.md).
# Réf. : oto_mcp/config.py:255
OTO_MCP_CORS_ORIGINS=

# Relais mailer des emails de plateforme (endpoint `/api/send`, bearer
# `OTO_MAILER_SEND_BEARER`). Un des deux transports de l'instance : laissée vide
# quand elle envoie par son API Scaleway TEM (`OTO_TEM_SECRET_KEY`,
# `OTO_TEM_PROJECT_ID`, `OTO_TEM_REGION`). Aucun des deux, ou les deux : refus
# de démarrer (`email.transport_plateforme`).
# Réf. : oto_mcp/email.py:49
OTO_MAILER_URL=

# Expéditeur par défaut des emails composés.
# Réf. : oto_mcp/email.py:74, oto_mcp/scheduler.py:99, oto_mcp/tools/email.py:228
OTO_MAIL_FROM=

# Boîte de réception (reply-to) d'un email composé sans `reply_to` explicite.
# Réf. : oto_mcp/email.py:79
OTO_CONTACT_TO=

# Les documents légaux que l'instance fait accepter, en JSON — un objet par slug
# de `legal_docs.CONTEXTS` : `{"terms": {"version": "1.0", "label": "CGU",
# "url": "https://…"}, "cgv": {…}, "dpa": {…}}`. Un slug manquant ou en trop, un
# champ vide : refus de démarrer. Bumper `version` redemande l'acceptation.
# Réf. : oto_mcp/legal_docs.py:66
OTO_LEGAL_DOCS=

# Nom du produit du tenant primaire, tel qu'il s'imprime dans les emails et les
# pages publiques.
# Réf. : oto_mcp/email_brand.py:135
OTO_BRAND_NAME=

# Site du tenant primaire, hôte nu (`exemple.tld`) : pied des emails, lien du
# pied des pages publiques.
# Réf. : oto_mcp/email_brand.py:139
OTO_BRAND_SITE=

# Slug du tenant PRIMAIRE de l'instance (#969, ADR 0070 §7.2) : la ligne 1 de
# `tenants`, semée à la naissance de la base sous ce slug et le nom
# `OTO_BRAND_NAME`, dont les subs restent nus. Plus de constante « nous ». Une
# base existante dont la ligne 1 porte un autre slug refuse le démarrage.
# L'instance historique déclare `oto`.
# Réf. : oto_mcp/tenancy.py:74, oto_mcp/identite_instance.py:45, oto_mcp/db/_tenant_primaire.py:45
OTO_TENANT_PRIMAIRE_SLUG=

# ── RÉGLAGES — défaut neutre légitime en toute instance (timeout, cadence,
# taille, rétention, interrupteur, secret optionnel). À toucher seulement
# pour dévier du défaut. ────────────────────────────────────────────────

# Services Google que demande la carte du COMPTE sous notre app, sur cette
# instance : sous-ensemble séparé par des virgules de sheets, drive, gmail,
# tasks, calendar, chat, ou `none` (l'identité seule). Absente ou vide = les
# six. Pour une instance dont le projet Google n'est vérifié que pour certains
# scopes ; un service inconnu lève.
# Réf. : oto_mcp/auth/google.py:140
# GOOGLE_ACCOUNT_SERVICES=

# Chemins des liens servis vers le tableau de bord de CETTE instance, en JSON
# `{type: chemin}` fusionné sur `links.DEFAULT_PATHS` (ex. `{"table":
# "/org/{org}/tables/{id}"}`). Vide = les chemins par défaut. Une déclaration
# illisible ou un type de lien inconnu refuse le démarrage
# (`links.verifier_reglages`).
# Réf. : oto_mcp/links.py:95
# OTO_DASHBOARD_LINK_PATHS=

# Langue (`fr`|`en`) des emails du tenant primaire pour un destinataire sans
# préférence connue (un invité sans compte). Vide = FR ; toute autre valeur lève
# `LangueInconnue` à l'envoi.
# Réf. : oto_mcp/email_brand.py:131
# OTO_BRAND_LANGUE=

# `prod`|`preprod`, DÉCLARÉ jamais deviné (ADR 0070). Absente → `None` (poste de
# dev, tests) : rien n'engage un tiers. Une valeur hors des deux lève
# `EnvironnementAmbigu`.
# Réf. : oto_mcp/config.py:108
# OTO_ENV=

# Répertoire du bac à sable des fonctions (ADR 0073), posé par
# `scripts/installer_bac_a_sable.py`. Absente : `<arbre>/.bac-a-sable`, que le
# déploiement bleu/vert pose dans l'arbre de chaque couleur ; s'il n'existe pas
# non plus, l'instance n'exécute pas de fonction — `oto_function` et les
# recettes-code rendent 503 `sandbox_unavailable`, le reste répond.
# Réf. : oto_mcp/functions/executor.py:92
# OTO_FUNCTIONS_SANDBOX_DIR=

# Isolement du processus du bac à sable des fonctions
# (`functions/isolement.py`). `systemd` (défaut) : unité transitoire durcie sous
# l'utilisateur dédié `OTO_FUNCTIONS_USER`, pour un service qui peut lancer une
# unité sous un autre uid. `bwrap` : espace de noms utilisateur non privilégié,
# pour un service sans privilège. `direct` : sans isolement système, à DEMANDER
# (poste de dev, CI) — jamais en prod. Une autre valeur, ou un outil ou un
# utilisateur absent, lève : 503 `sandbox_unavailable`, jamais de repli.
# Réf. : oto_mcp/functions/isolement.py:99
# OTO_FUNCTIONS_ISOLATION=systemd

# L'utilisateur dédié, non privilégié, sous lequel le mode `systemd` lance le
# bac à sable. Absent de la machine, ou privilégié : refus (503
# `sandbox_unavailable`).
# Réf. : oto_mcp/functions/isolement.py:126
# OTO_FUNCTIONS_USER=oto-fonctions

# Agents sur l'abonnement Claude de la personne : ouverts à TOUT compte de
# l'instance (`1`, `true`, `yes`, `on`). Absente, vide ou un non = seulement les
# porteurs de l'option `claude_subscription` ; toute autre valeur lève.
# Réf. : oto_mcp/capabilities/_abonnement.py:205
# OTO_ABONNEMENT_OUVERT_A_TOUS=

# Repli d'un travail d'abonnement Claude épuisé sur la clé API DÉPOSÉE par son
# org, pour une org qui ne l'a jamais réglé (`1`, `true`, `yes`, `on`). Absente,
# vide ou un non = ces travaux attendent la réinitialisation ; l'org peut
# toujours l'ouvrir ou le couper. Toute autre valeur lève.
# Réf. : oto_mcp/db/org_subscription_pool.py:75
# OTO_REPLI_API_PAR_DEFAUT=

# Ouvre à la plateforme, à chaque boot, tout connecteur du registre qui n'y a
# encore AUCUNE ligne (`1`, `true`, `yes`, `on`) — arriéré compris : au premier
# boot, tous les connecteurs jamais décidés, pas seulement ceux de la release.
# Les connecteurs à clé plateforme (`platform_key_open`) sont exclus et restent
# fermés tant qu'une ligne plateforme ne les ouvre pas. Un OFF explicite reste
# OFF ; le boot journalise les ouverts et les exclus. Posée par rôle, elle écrit
# la BASE : si préprod et prod partagent la base, la poser sur un rôle ouvre
# pour les deux. Absente, vide ou un non = deny-by-default. Toute autre valeur
# lève.
# Réf. : oto_mcp/connectors/activation.py:150
# OTO_CONNECTEURS_ACTIFS_PAR_DEFAUT=

# Slugs de tenants (virgules) dont les membres d'équipe ne sont jamais « sans
# équipe » : faute d'équipe désignée, l'équipe du sub dans l'org résolue.
# Absente = aucun tenant, le niveau org de toujours.
# Réf. : oto_mcp/access/scope.py:156
# OTO_EQUIPE_PAR_DEFAUT_TENANTS=

# URL du bundle JS (`…/process-graph.js`, sa feuille `.css` à côté) qui peint le
# graphe d'une procédure dans l'hôte MCP (`oto_procedure_app`). Absente = l'app
# ne s'enregistre pas : une instance sans front qui la porte ne sert aucune page
# qui pointerait vers personne.
# Réf. : oto_mcp/procedure_diagram.py:439
# OTO_PROCEDURE_APP_BUNDLE=

# URL du bundle JS d'un front (`…/process-graph.js`, sa feuille `.css` à côté)
# qui peint `data_app` dans l'hôte MCP, au lieu de la carte Prefab. Absente = la
# carte Prefab, inchangée.
# Réf. : oto_mcp/tools/datastore_table_app.py:51
# OTO_DATA_APP_BUNDLE=

# Destinations internes autorisées en egress (`nom=adresse:port`, virgules).
# Absente = aucune exception : fail-closed, jamais un défaut qui ouvre la
# machine.
# Réf. : oto_mcp/egress.py:138
# OTO_EGRESS_ALLOW=

# Adresse IP sortante de l'instance, servie par le marqueur `{{egress_ip}}` des
# docs connecteur (liste blanche d'IP chez le fournisseur, ex. Salesforce).
# Absente = la doc dit « demandez-la au support », jamais l'adresse d'une autre
# instance.
# Réf. : oto_mcp/connectors/docs_reader.py:87
# OTO_EGRESS_IP=

# Verrou d'org des jetons de délégation (`verrou_org.py`) : `enforce` (défaut)
# refuse toute résolution du porteur hors de l'org de son travail, `report` la
# journalise et la laisse passer, `off` le coupe. Une valeur inconnue vaut
# `enforce`.
# Réf. : oto_mcp/verrou_org.py:141
# OTO_VERROU_ORG_DELEGATION=

# Verrou des rôles PLATEFORME des jetons de délégation (`verrou_org.py`) :
# `enforce` lit `member` le porteur `admin`/`super_admin` d'un travail du runner
# (aucune garde plateforme, aucun `oto_admin_*` — sauf, pendant leur appel, ceux
# que son agent nomme : `platform_tools`), `report` (défaut) journalise ce qui
# serait retiré et ne retire rien, `off` le coupe. Une valeur inconnue vaut
# `report`. Indépendant d'`OTO_VERROU_ORG_DELEGATION`.
# Réf. : oto_mcp/verrou_org.py:226
# OTO_VERROU_ROLES_PLATEFORME=report

# L'agent intégré à l'application (`capabilities/copilot`, docs/copilot.md) :
# les `sub` autorisés, séparés par des virgules. Vide (défaut) = personne — les
# quatre routes `/api/copilot/*` répondent 403 `copilot_not_enabled`. `*` = tout
# compte (session console, membre de l'org, jamais en « voir en tant que »). Lu
# à chaque requête.
# Réf. : oto_mcp/capabilities/copilot/routes.py:61
# OTO_COPILOT_SUBS=

# L'agent intégré à l'application : plafond de dépense au modèle PAR COMPTE ET
# PAR JOUR UTC, en dollars (prix publics du fournisseur × jetons rapportés,
# `capabilities/copilot/depense.py`), quelle que soit la clé et quel que soit
# `OTO_CREDITS_MODE`. Atteint : 429 `copilot_daily_cap` avant le flux, refus
# nommé dans le flux avant l'appel suivant. Lu à chaque appel ; une valeur qui
# n'est pas un montant positif lève (jamais le défaut en silence).
# Réf. : oto_mcp/capabilities/copilot/depense.py:59
# OTO_COPILOT_DAILY_CAP_USD=20

# L'agent intégré à l'application : la voix ElevenLabs qui lit ses réponses
# quand le panneau demande `speak` (`capabilities/copilot/voix.py`, modèle
# `eleven_flash_v2_5`, par la clé ElevenLabs de l'org ou la clé plateforme
# octroyée). Absente ou vide : la voix prédéfinie « Sarah ». Lu à chaque tour.
# Réf. : oto_mcp/capabilities/copilot/voix.py:47
# OTO_COPILOT_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Budget d'unités au moment de l'appel (`access/credits.py`) : `report` (défaut)
# réserve et règle sans jamais refuser, et journalise ce qu'`enforce` refuserait
# ; `enforce` refuse (`insufficient_credits`, `credits_unpriced`,
# `spend_ledger_unavailable`) ; `off` ne réserve rien. Illisible : LÈVE au boot.
# Réf. : oto_mcp/access/credits.py:94
# OTO_CREDITS_MODE=report

# Budget d'unités : le mode PAR FONCTION du barème, qui l'emporte sur
# `OTO_CREDITS_MODE` pour elle (`access/credits_modes.mode_de`) — liste
# `<connecteur>.<fonction>=<mode>` séparée par des virgules, `*` final = toute
# fonction qui commence ainsi ; un nom exact l'emporte toujours sur un motif, et
# entre motifs le préfixe le plus long. Ex. `anthropic.messages:*=enforce` : les
# appels au modèle (agents hébergés, agent intégré) refusent, le reste reste en
# `report` (#1376, E). Absente ou vide : aucune. Illisible, nommée deux fois, ou
# qui ne nomme aucune fonction tarifable (coût déclaré d'un connecteur, modèle
# du catalogue) : LÈVE au boot.
# Réf. : oto_mcp/access/credits_modes.py:39
# OTO_CREDITS_MODE_FUNCTIONS=

# Budget d'unités : le solde disponible (solde − réservations ouvertes), en
# unités, qu'un travail d'agent hébergé sur une clé REFACTURÉE doit avoir pour
# démarrer — il couvre l'entrée du premier tour, jamais réservée
# (`access/credits_tours.sous_le_plancher`, #1376, B). Mord dans le mode de la
# fonction du modèle : `enforce` arrête le travail, raison écrite
# (`insufficient_credits`), et rend à la file un travail dont le solde est
# illisible (`spend_ledger_unavailable`, rejouable) ; `report` journalise.
# Absente ou 0 : aucun plancher. Illisible ou négative : LÈVE au boot.
# Réf. : oto_mcp/access/credits_modes.py:119
# OTO_CREDITS_JOB_FLOOR=

# Durée maximale d'une réservation sans échéance connue (travail asynchrone sans
# `within_s`, tranche de fond `jev_rows`, appel synchrone quand
# OTO_BORNE_OUTIL_S=0 et sans `timeout_s`), en secondes (défaut 86400 dans le
# code, 1 au moins). Illisible : LÈVE au boot.
# Réf. : oto_mcp/access/credits.py:107
# OTO_CREDITS_HOLD_MAX_S=

# Marge de l'échéance d'un appel synchrone : max(OTO_BORNE_OUTIL_S, `timeout_s`
# déclaré) + cette marge, en secondes (défaut 60 dans le code, 1 au moins).
# Illisible : LÈVE au boot.
# Réf. : oto_mcp/access/credits.py:113
# OTO_CREDITS_SYNC_MARGIN_S=

# Équité d'une clé PLATEFORME partagée entre orgs (F-051,
# `access/platform_rate.py`) : `enforce` refuse l'appel d'une org au-delà de sa
# part de la fenêtre, `report` (défaut) journalise une fois par fenêtre l'org
# qui la dépasse et ne refuse rien, `off` ne compte rien. Une valeur inconnue
# LÈVE au boot.
# Réf. : oto_mcp/access/platform_rate.py:64
# OTO_PLATFORM_KEY_ORG_RATE=report

# Appels d'UNE org sur UNE clé plateforme partagée par fenêtre (défaut 120 dans
# le code ; 0 = sans limite). Illisible : LÈVE au boot.
# Réf. : oto_mcp/access/platform_rate.py:111
# OTO_PLATFORM_KEY_ORG_RATE_LIMIT=

# Durée en secondes de la fenêtre fixe de l'équité des clés plateforme (défaut
# 60 dans le code, 1 au moins). Illisible : LÈVE au boot.
# Réf. : oto_mcp/access/platform_rate.py:87
# OTO_PLATFORM_KEY_ORG_RATE_WINDOW_S=

# Limites par connecteur porteur de la clé, `serper=600,aiark=30` ; `0` = sans
# limite pour ce connecteur. Vide = la limite commune partout. Une paire
# illisible LÈVE au boot.
# Réf. : oto_mcp/access/platform_rate.py:97
# OTO_PLATFORM_KEY_ORG_RATE_OVERRIDES=

# Interrupteur du journal des révisions de ligne du datastore (oto#273) : `off`
# le coupe pour les écritures de CE processus, sans redéployer (un redémarrage
# suffit). Toute autre valeur que `on`/`off` LÈVE au boot.
# Réf. : oto_mcp/db/journal_revisions.py:70
# OTO_JOURNAL_REVISIONS=on

# Seuil (s) d'avertissement d'un callback lent (event loop).
# Réf. : oto_mcp/hang_watch.py:200, oto_mcp/loop_watch.py:35
# OTO_SLOW_CALLBACK_WARN=1.0

# Seuil (s) au-delà duquel un callback lent part vers Sentry.
# Réf. : oto_mcp/loop_watch.py:36
# OTO_SLOW_CALLBACK_SENTRY=10.0

# Plafond quotidien de destinataires (`to` + `cc`) d'`email_send` par org sur le
# transport commun (le relais de l'instance) ; une org qui envoie avec sa clé
# n'en a aucun. Une valeur illisible lève au premier envoi.
# Réf. : oto_mcp/tools/email.py:78
# OTO_EMAIL_PLATFORM_DAILY_RECIPIENTS=200

# Rétention EN LIGNE (jours) du journal d'appels : au-delà, chaque mois clos est
# archivé sur S3 puis supprimé (`deploy/archive_tool_calls.py`).
