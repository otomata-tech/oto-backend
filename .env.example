# oto-mcp environment
#
# Fichier DÉRIVÉ — ne pas éditer à la main. Régénéré depuis
# oto_mcp/env_inventory.py par `python -m scripts.generer_env_example`
# (oto-backend#968). Toute variable lue par le code y a une entrée ;
# `tests/test_env_inventory_complet.py` le garantit contre le CODE et
# `tests/test_env_example_a_jour.py` garantit CE fichier contre l'inventaire.

# ── REQUISES — le boot (ou le premier appel qui en dépend) échoue
# proprement sans elles. Aucun défaut : à poser explicitement. ──────────

# Connexion PG managée — source unique du pool applicatif ET des migrations
# Alembic (décision du 15/09/2026 : un message de boot nommé plutôt qu'une
# erreur psycopg opaque).
# Réf. : oto_mcp/db/_conn.py:57, oto_mcp/db/migrations/env.py:51
DATABASE_URL=

# Domaine racine des endpoints de projet publiés (`<slug>.mcp.<D>`,
# `<slug>.share.<D>`). Décision du 15/09/2026 : plus de défaut muet vers
# `oto.cx`, même raison que l'URL publique — une instance tierce doit déclarer
# le sien, prod comprise.
# Réf. : oto_mcp/config.py:66
OTO_PROJECT_DOMAIN=

# Émetteur Logto qui SIGNE (vérification JWT ES384) — distinct de l'endpoint
# ANNONCÉ (`LOGTO_PUBLIC_ENDPOINT`).
# Réf. : oto_mcp/server.py:226, oto_mcp/auth/facade.py:50
LOGTO_ENDPOINT=

# Audience RFC 9728 canonique vérifiée sur chaque jeton.
# Réf. : oto_mcp/server.py:290
MCP_AUDIENCE=

# L'adresse publique de CETTE instance — seule source des liens donnés à un
# tiers (redirection OAuth, rappel de paiement, jeton de téléversement, suffixe
# d'hôte). Lève à l'appel, pas à l'import.
# Réf. : oto_mcp/config.py:37, oto_mcp/server.py:395
OTO_MCP_PUBLIC_URL=

# Endpoint S3/Scaleway du store média.
# Réf. : oto_mcp/media_store.py:60
OTO_MCP_S3_ENDPOINT=

# Clé d'accès S3 du store média.
# Réf. : oto_mcp/media_store.py:62
OTO_MCP_S3_ACCESS_KEY=

# Clé secrète S3 du store média.
# Réf. : oto_mcp/media_store.py:63
OTO_MCP_S3_SECRET_KEY=

# Bucket S3 du store média.
# Réf. : oto_mcp/media_store.py:70
OTO_MCP_S3_BUCKET=

# Clé AES-256 (hex 64 ou base64) du coffre credentials — HORS DB. Obligatoire DE
# FAIT : la lecture rend `None` sans lever, mais `encrypt`/`decrypt` lèvent
# nommé au premier usage réel.
# Réf. : oto_mcp/crypto.py:45, oto_mcp/crypto.py:65, oto_mcp/crypto.py:74
OTO_MCP_MASTER_KEY=

# Clé qui signe l'état OAuth et les jetons courts (upload, invite, optout).
# Obligatoire DE FAIT à 4 des 5 sites qui la lisent (lèvent nommé) ;
# `journal_secrets.py` est l'exception VOLONTAIRE — sans elle (dev, tests) il
# dégrade vers une clé de process aléatoire, le masque reste correct et cesse
# seulement d'être corrélable entre deux boots.
# Réf. : oto_mcp/auth/flow.py:66, oto_mcp/auth/google.py:87, oto_mcp/outreach_optout.py:57, oto_mcp/upload_tokens.py:72
OTO_MCP_OAUTH_STATE_SECRET=

# Client OAuth Google Workspace. Obligatoire DE FAIT : lève nommé au premier
# appel de `_client_id()`.
# Réf. : oto_mcp/auth/google.py:73
GOOGLE_WORKSPACE_CLIENT_ID=

# Secret OAuth Google Workspace. Obligatoire DE FAIT : lève nommé au premier
# appel de `_client_secret()`.
# Réf. : oto_mcp/auth/google.py:80
GOOGLE_WORKSPACE_CLIENT_SECRET=

# Base URL du service FOD (ADR 0028 — CCN, jurisprudence, lois, règlements,
# DVF). Obligatoire DE FAIT : lue nue au niveau module, `_client()` lève nommé
# au premier appel si absente.
# Réf. : oto_mcp/fod/http.py:24, oto_mcp/fod/http.py:42
FOD_BASE_URL=

# Jeton du service FOD. Même mécanique que `FOD_BASE_URL`.
# Réf. : oto_mcp/fod/http.py:25, oto_mcp/fod/http.py:42
FOD_API_TOKEN=

# Relais d'envoi d'email (TEM). Résolue paresseusement, requise dès qu'un envoi
# est tenté (bearer posé) — sans elle, le courrier transiterait par NOTRE infra.
# Réf. : oto_mcp/email.py:21
OTO_MAILER_URL=

# Expéditeur par défaut des emails composés. Même mécanique.
# Réf. : oto_mcp/email.py:25, oto_mcp/scheduler.py:99, oto_mcp/tools/email.py:228
OTO_MAIL_FROM=

# Boîte de réception par défaut (reply-to) d'un email composé sans `reply_to`
# explicite. Sans elle, le repli visait NOTRE boîte personnelle.
# Réf. : oto_mcp/email.py:365
OTO_CONTACT_TO=

# Première variable de la cascade `dashboard_url()` — une seule des trois suffit
# ; épuisées toutes les trois, le boot refuse plutôt que d'offrir
# silencieusement NOTRE dashboard à sa place.
# Réf. : oto_mcp/config.py:229, oto_mcp/auth/flow.py:180
OTO_APP_URL=

# Deuxième variable de la cascade `dashboard_url()` — voir `OTO_APP_URL`.
# Réf. : oto_mcp/config.py:229
OTO_DASHBOARD_URL=

# Troisième variable de la cascade `dashboard_url()` — voir `OTO_APP_URL`.
# Réf. : oto_mcp/config.py:229
OTO_DASHBOARD_BASE_URL=

# ── DÉFAUT = UNE VALEUR À NOUS — absente, chacune pointe chez NOUS (notre
# domaine, notre adresse). Une instance tierce DOIT les écraser sous peine
# de nous envoyer du trafic qui ne nous appartient pas. Pas de garde de
# boot dessus (décision du 15/09/2026) : elles se documentent, c'est tout. ──

# NOTRE domaine dans les liens d'invitation. Hors périmètre de ce lot (#968) —
# un autre chantier touche ce fichier, ne pas y toucher ici.
# ⚠️ Défaut = NOTRE valeur ('https://oto.cx') — à écraser pour toute instance qui n'est pas nous.
# Réf. : oto_mcp/capabilities/orgs/invites.py:41
# OTO_INVITE_BASE_URL=https://oto.cx

# Absente, la liste en dur ne sert QUE nos domaines `oto.*`/`ninja.*` (+ 2
# origines client marquées `noqa: CLIENT`) et une dizaine de ports `localhost`
# de confort dev. Un env-liste s'ÉTEND, ne se remplace jamais
# (docs/auth-logto.md). Volontairement NON basculée en REQUISE (16/09/2026) : le
# défaut mélange un risque « pointe chez nous » et un confort de dev local
# légitime — les deux n'appellent pas le même traitement, à trancher séparément.
# ⚠️ Défaut = NOTRE valeur ('') — à écraser pour toute instance qui n'est pas nous.
# Réf. : oto_mcp/api/base.py:43
# OTO_MCP_CORS_ORIGINS=

# ── RÉGLAGES — défaut neutre légitime en toute instance (timeout, cadence,
# taille, rétention, interrupteur, secret optionnel). À toucher seulement
# pour dévier du défaut. ────────────────────────────────────────────────

# Hosts déclarés du relais d'autorisation OAuth (RFC 9207,
# `oto_mcp/auth/relay.py`), séparés par des virgules. Absente : aucun relais
# actif, comportement d'origine — un opt-in par host, pas un défaut qui
# pointerait chez nous.
# Réf. : oto_mcp/auth/relay.py:73
# OTO_MCP_OAUTH_RELAY_HOSTS=

# `prod`|`preprod`, DÉCLARÉ jamais deviné (ADR 0070). Absente → `None` (poste de
# dev, tests) : rien n'engage un tiers. Une valeur hors des deux lève
# `EnvironnementAmbigu`.
# Réf. : oto_mcp/config.py:108
# OTO_ENV=

# Répertoire du bac à sable des fonctions (ADR 0073), posé par
# `scripts/installer_bac_a_sable.py`. Absente : l'instance n'exécute pas de
# fonction — `oto_function` op=run/test/publish rend 503 `sandbox_unavailable`,
# le reste répond.
# Réf. : oto_mcp/functions/executor.py:60
# OTO_FUNCTIONS_SANDBOX_DIR=

# Destinations internes autorisées en egress (`nom=adresse:port`, virgules).
# Absente = aucune exception : fail-closed, jamais un défaut qui ouvre la
# machine.
# Réf. : oto_mcp/egress.py:138
# OTO_EGRESS_ALLOW=

# Déplace la date par défaut (`datastore/schema.py:ORIGINE_REFUS_LE`,
# 2026-10-01) à partir de laquelle poser la couche `origine` sans la déclarer
# est refusé. Une valeur illisible LÈVE plutôt que de retomber sur le défaut.
# Réf. : oto_mcp/datastore/champs_reserves.py:96
# OTO_ORIGINE_REFUS_LE=

# Sœur exacte d'`OTO_ORIGINE_REFUS_LE`, même mécanique, pour le refus d'écrire
# `null` sans le déclarer.
# Réf. : oto_mcp/datastore/fin_du_null.py:66
# OTO_NULL_REFUSE_LE=

# Seuil (s) d'avertissement d'un callback lent (event loop).
# Réf. : oto_mcp/hang_watch.py:200, oto_mcp/loop_watch.py:35
# OTO_SLOW_CALLBACK_WARN=1.0

# Seuil (s) au-delà duquel un callback lent part vers Sentry.
# Réf. : oto_mcp/loop_watch.py:36
# OTO_SLOW_CALLBACK_SENTRY=10.0

# Rétention (jours) du journal d'appels avant purge en maintenance.
# Réf. : oto_mcp/maintenance.py:57
# OTO_JOURNAL_RETENTION_DAYS=90

# Rétention (jours) des fils de run avant purge.
# Réf. : oto_mcp/maintenance.py:63
# OTO_MCP_RUN_THREAD_RETENTION_DAYS=30

# Niveau de log du process.
# Réf. : oto_mcp/server.py:887, oto_mcp/cli.py:40
# LOG_LEVEL=INFO

# Nombre d'essais de `datastore_claim_next` sur `DeadlockDetected`
# (oto-backend#990, Sentry PYTHON-STARLETTE-8Z) — victime d'un cycle contre une
# migration de boot, rien n'est jamais posé côté claim, un rejeu est aussi sûr
# qu'un premier essai.
# Réf. : oto_mcp/db/rowlock.py:173
# OTO_MCP_CLAIM_DEADLOCK_ATTEMPTS=3

# Taille de page par défaut des lectures Unipile.
# Réf. : oto_mcp/unipile_connect.py:49
# OTO_MCP_UNIPILE_DEFAULT_LIMIT=5

# Plafond dur (octets) d'un contenu poussé par jeton de téléversement — 25 Mo,
# distinct du plafond image S3.
# Réf. : oto_mcp/upload_tokens.py:67, oto_mcp/upload_tokens.py:49
# OTO_MCP_UPLOAD_MAX_BYTES=26214400

# Horodatage Unix plancher : un jeton émis avant est refusé (révocation globale
# par date).
# Réf. : oto_mcp/server.py:293
# MIN_TOKEN_IAT=0

# Transport MCP (`streamable_http` ou `stdio` en local).
# Réf. : oto_mcp/server.py:918
# MCP_TRANSPORT=streamable_http

# Adresse d'écoute du serveur.
# Réf. : oto_mcp/server.py:945
# HOST=127.0.0.1

# Port d'écoute du serveur.
# Réf. : oto_mcp/server.py:946
# PORT=9103

# Cadence (s) entre appels dans le scan dirigeants FR.
# Réf. : oto_mcp/tools/fr.py:432
# FR_DIRECTORS_CADENCE_S=0.2

# TTL (s) du cache de feed Unipile.
# Réf. : oto_mcp/tools/unipile.py:362
# OTO_UNIPILE_FEED_TTL_SECONDS=600

# Débit anonyme (req/min) par endpoint de projet publié.
# Réf. : oto_mcp/subdomain_project.py:132
# OTO_ANON_RATE_PER_MIN=120

# Rafale anonyme autorisée en plus du débit régulier.
# Réf. : oto_mcp/subdomain_project.py:139
# OTO_ANON_RATE_BURST=60

# Plafond d'orgs créées par un même compte.
# Réf. : oto_mcp/capabilities/orgs/core.py:19
# OTO_MCP_MAX_ORGS_PER_USER=10

# Durée de vie (jours) d'une invitation d'org.
# Réf. : oto_mcp/capabilities/orgs/invites.py:34
# OTO_MCP_INVITE_TTL_DAYS=7

# `idle_in_transaction_session_timeout` du pool applicatif.
# Réf. : oto_mcp/db/_conn.py:73
# OTO_MCP_DB_IDLE_TX_TIMEOUT_MS=60000

# `statement_timeout` du pool applicatif — opt-in, off par défaut (un DDL de
# migration ne doit pas être coupé au boot).
# Réf. : oto_mcp/db/_conn.py:74
# OTO_MCP_DB_STATEMENT_TIMEOUT_MS=0

# `lock_timeout` du DDL à chaud (`CREATE INDEX CONCURRENTLY`).
# Réf. : oto_mcp/db/_conn.py:97, oto_mcp/db/_conn.py:104
# OTO_MCP_DDL_LOCK_TIMEOUT_MS=5000

# `statement_timeout` du DDL à chaud.
# Réf. : oto_mcp/db/_conn.py:98, oto_mcp/db/_conn.py:105
# OTO_MCP_DDL_STATEMENT_TIMEOUT_MS=60000

# Taille max du pool de connexions PG applicatif.
# Réf. : oto_mcp/db/_conn.py:126
# OTO_MCP_DB_POOL_MAX=24

# Attente max (s) d'une connexion du pool avant `PoolTimeout`.
# Réf. : oto_mcp/db/_conn.py:134
