# Timeout (s) des requêtes DVF (FOD).
# Réf. : oto_mcp/fod/foncier.py:29
# FOD_DVF_TIMEOUT_S=20

# Tentatives de `init_db()` au boot avant abandon.
# Réf. : oto_mcp/db/_init.py:53
# OTO_MCP_INIT_DB_ATTEMPTS=3

# `lock_timeout` du verrou consultatif d'init DB au boot.
