# MISTRAL_API_KEY=

# Bearer du relais mailer commun (byo-org a le sien en coffre).
# Réf. : oto_mcp/email.py:48
# OTO_MAILER_SEND_BEARER=

# Clé Mollie plateforme (ADR 0043).
# Réf. : oto_mcp/mollie_client.py:58
# MOLLIE_API_KEY=

# Base publique alternative d'un objet S3 — absente, dérivée de
# `OTO_MCP_S3_ENDPOINT` (virtual-hosted Scaleway).
# Réf. : oto_mcp/media_store.py:87
# OTO_MCP_S3_PUBLIC_BASE_URL=

# DSN Sentry — vide, Sentry est no-op.
# Réf. : oto_mcp/sentry_setup.py:90
