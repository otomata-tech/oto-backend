"""Le harnais Python, joué DANS le bac à sable (Pyodide), jamais par le serveur.

`sandbox.ts` l'exécute après avoir posé `_tache_json`. Il écrit les sources dans le
système de fichiers EN MÉMOIRE de Pyodide (rien ne touche le disque de la machine),
puis joue soit la fonction (`run`), soit ses tests (`test`), et rend du JSON.

⚠️ Le code de la fonction tourne dans le MÊME interpréteur que ce harnais. Les tests
prouvent donc la non-régression d'un code honnête, pas l'innocuité d'un code hostile :
depuis le 28/10/2026, le membre publie dans sa portée, sans relecture de plateforme ;
c'est le bac à sable (ni réseau, ni secret, bornes) qui borne un code hostile.

Ce fichier est lu comme du TEXTE par `executor.py` et n'est jamais importé côté serveur :
d'où son extension, qui n'est pas `.py`. Importé, il lèverait à la première ligne
(`_tache_json` n'existe que dans le bac à sable), et le contrôle de la CI qui importe
chaque module de `oto_mcp/` (`scripts/arbre-importable.py`) le refuserait.
"""
import base64
import importlib
import json
import os
import sys
import traceback

_TACHE = json.loads(_tache_json)  # noqa: F821 — posé par sandbox.ts
_DOSSIER = "/fonction"
_MAX_TRACE = 2000


def _poser_les_sources():
    os.makedirs(_DOSSIER, exist_ok=True)
    for nom, contenu in _TACHE["sources"].items():
        with open(os.path.join(_DOSSIER, nom), "w", encoding="utf-8") as f:
            f.write(contenu)
    os.chdir(_DOSSIER)
    sys.path.insert(0, _DOSSIER)


def _trace():
    return traceback.format_exc(limit=8)[-_MAX_TRACE:]


def _fichier(f):
    """Un fichier rendu par la fonction : `{name, content: bytes, mime?}`."""
    if not isinstance(f, dict) or not isinstance(f.get("name"), str):
        raise TypeError("chaque fichier se rend {'name': str, 'content': bytes, 'mime': str?}")
    contenu = f.get("content")
    if not isinstance(contenu, (bytes, bytearray)):
        raise TypeError(f"fichier {f['name']!r} : `content` doit être des octets")
    return {"name": f["name"], "mime": f.get("mime") or "application/octet-stream",
            "base64": base64.b64encode(bytes(contenu)).decode("ascii")}


def _executer():
    module, fonction = _TACHE["entrypoint"].split(":")
    try:
        sortie = getattr(importlib.import_module(module), fonction)(_TACHE["input"])
        if not isinstance(sortie, dict):
            raise TypeError("la fonction doit rendre un dict {result, warnings?, files?}")
        avertissements = sortie.get("warnings") or []
        if not all(isinstance(a, str) for a in avertissements):
            raise TypeError("`warnings` doit être une liste de phrases")
        rendu = {"result": sortie.get("result"), "warnings": list(avertissements),
                 "files": [_fichier(f) for f in (sortie.get("files") or [])]}
        json.dumps(rendu["result"])
        return {"ok": True, **rendu}
    except Exception:  # noqa: SILENT — l'erreur du code de la fonction EST le résultat : rendue avec sa trace
        return {"ok": False, "error": _trace()}


def _tester():
    resultats = []
    for nom in sorted(_TACHE["sources"]):
        if not (nom.startswith("test_") and nom.endswith(".py")):
            continue
        try:
            module = importlib.import_module(nom[:-3])
        except Exception:  # noqa: SILENT — l'erreur du code de la fonction EST le résultat : rendue avec sa trace
            resultats.append({"test": nom[:-3], "ok": False, "error": _trace()})
            continue
        for attribut in sorted(vars(module)):
            cas = getattr(module, attribut)
            if not (attribut.startswith("test_") and callable(cas)):
                continue
            try:
                cas()
                resultats.append({"test": f"{nom[:-3]}.{attribut}", "ok": True})
            except Exception:  # noqa: SILENT — l'erreur du code de la fonction EST le résultat : rendue avec sa trace
                resultats.append({"test": f"{nom[:-3]}.{attribut}", "ok": False,
                                  "error": _trace()})
    return {"ok": bool(resultats) and all(r["ok"] for r in resultats), "tests": resultats}


_poser_les_sources()
json.dumps(_executer() if _TACHE["mode"] == "run" else _tester())
